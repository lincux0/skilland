{
  "name": "skill-shelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run test:scan && npm run validate && astro build && npm run index",
    "index": "pagefind --site dist",
    "preview": "astro preview",
    "validate": "tsx scripts/validate-data.ts",
    "test:scan": "tsx scripts/test-scan.ts",
    "sync": "tsx scripts/sync.ts",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tar": "^7.5.23",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pagefind": "^1.6.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
