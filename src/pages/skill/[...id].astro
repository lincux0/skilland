---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SkillCard from "../../components/SkillCard.astro";
import AgentBadges from "../../components/AgentBadges.astro";
import InstallCommand from "../../components/InstallCommand";
import { getAllSkills } from "../../lib/skills";
import { getScene } from "../../lib/content";
import type { SkillRecord } from "../../lib/schema";
import {
  formatBytes,
  formatDate,
  formatTokens,
  licenseLabel,
  reviewLabel,
  scanLabel,
  shortCommit,
  statusLabel,
  topicLabel,
} from "../../lib/format";

export function getStaticPaths() {
  return getAllSkills().map((skill) => ({
    params: { id: skill.publicId },
    props: { skill },
  }));
}

const { skill } = Astro.props as { skill: SkillRecord };
const sceneItems = skill.taxonomy.scenes
  .map((id) => getScene(id))
  .filter((scene): scene is NonNullable<typeof scene> => Boolean(scene));
const related = getAllSkills()
  .filter(
    (item) =>
      item.publicId !== skill.publicId &&
      item.taxonomy.scenes.some((scene) => skill.taxonomy.scenes.includes(scene)),
  )
  .slice(0, 3);
const sourceUrl = `https://github.com/${skill.source.fullName}/blob/${skill.snapshot.commit}/${skill.path}`;
const isDraft = skill.status === "draft";
const licenseText = licenseLabel(skill.source.licenseSpdx, skill.source.licenseStatus);
const riskValues = skill.scan.flags.length
  ? [...new Set(skill.scan.flags.map((flag) => flag.severity))]
  : ["none"];
const severityClass: Record<string, string> = {
  critical: "border-danger/40 text-danger",
  high: "border-warn/40 text-warn",
  medium: "border-warn/30 text-warn",
  low: "border-line text-muted",
  warn: "border-line text-muted",
  info: "border-line text-faint",
};

const versions = skill.versions;
const scopeLabels: Record<string, string> = {
  description: "描述",
  "file-tree": "文件清单",
  "scan-evidence": "扫描证据",
  license: "许可证",
  "install-command": "安装命令",
};
const versionTone: Record<string, string> = {
  ok: "border-accent/40 text-accent",
  warn: "border-warn/40 text-warn",
  neutral: "border-line text-muted",
};
const versionState = !versions.reviewed
  ? {
      tone: "neutral",
      label: "未人工复核",
      text: "当前同步版本与扫描指纹一致；还没有人工复核记录，默认安装指向同步版本。",
    }
  : versions.consistency.reviewMatchesSnapshot
    ? {
        tone: "ok",
        label: "已复核 · 版本一致",
        text: `已由 ${versions.reviewed.reviewer} 于 ${formatDate(versions.reviewed.at)} 复核当前版本。复核是“人看过”，不是安全认证。`,
      }
    : {
        tone: "warn",
        label: "复核已失效",
        text:
          versions.reviewed.commit === versions.synced.commit
            ? `复核的是 @${shortCommit(versions.reviewed.commit)}，但 bundle 指纹与当前同步不一致，复核已失效。默认安装仍指向已复核版本。`
            : `复核的是 @${shortCommit(versions.reviewed.commit)}，当前同步已前进到 @${shortCommit(versions.synced.commit)}。默认安装仍指向已复核版本。`,
      };

const versionRows = [
  {
    label: "上游最新",
    value: `${shortCommit(versions.upstream.commit)} · ${formatDate(versions.upstream.at)}`,
    state: versions.consistency.upstreamAhead ? "上游有新 commit" : "与本站同步一致",
    tone: versions.consistency.upstreamAhead ? "warn" : "ok",
  },
  {
    label: "本站同步",
    value: `${shortCommit(versions.synced.commit)} · bundle ${versions.synced.bundleHash.slice(0, 10)}`,
    state: formatDate(versions.synced.at),
    tone: "neutral",
  },
  {
    label: "自动扫描",
    value: `${scanLabel(versions.scanned.status)} · @${shortCommit(versions.scanned.commit)}`,
    state: versions.consistency.scanMatchesSnapshot ? "指纹一致" : "扫描的不是当前版本",
    tone: versions.consistency.scanMatchesSnapshot ? "ok" : "warn",
  },
  {
    label: "人工复核",
    value: versions.reviewed
      ? `${shortCommit(versions.reviewed.commit)} · ${versions.reviewed.reviewer}`
      : "—（未复核）",
    state: !versions.reviewed
      ? "没有记录"
      : versions.consistency.reviewMatchesSnapshot
        ? "当前版本"
        : "已过期",
    tone: !versions.reviewed ? "neutral" : versions.consistency.reviewMatchesSnapshot ? "ok" : "warn",
  },
  {
    label: "默认安装",
    value: `@${shortCommit(versions.install.commit)}`,
    state: versions.install.source === "reviewed" ? "已复核版本" : "同步版本（未复核）",
    tone: versions.install.source === "reviewed" ? "ok" : "neutral",
  },
  {
    label: "Catalog",
    value: versions.catalog
      ? `${versions.catalog.version} · ${versions.catalog.bundleHash.slice(0, 10)}`
      : "—（未进入）",
    state: versions.catalog ? "已发布" : "未发布",
    tone: versions.catalog ? "ok" : "neutral",
  },
] as const;
---

<BaseLayout title={skill.name} description={skill.descriptionZh ?? skill.description}>
  <div class="hidden" aria-hidden="true">
    <span data-pagefind-filter="type:skill"></span>
    {skill.taxonomy.agents.map((agent) => (
      <span data-pagefind-filter={`agent:${agent}`}></span>
    ))}
    <span data-pagefind-filter={`scan:${skill.scan.status}`}></span>
    <span data-pagefind-filter={`license:${licenseText}`}></span>
    {riskValues.map((risk) => (
      <span data-pagefind-filter={`risk:${risk}`}></span>
    ))}
    {skill.taxonomy.scenes.map((scene) => (
      <span data-pagefind-filter={`scene:${scene}`}></span>
    ))}
    {(skill.editorial?.shelfIds ?? []).map((shelf) => (
      <span data-pagefind-filter={`shelf:${shelf}`}></span>
    ))}
    <span data-pagefind-meta="agents">{skill.taxonomy.agents.join(",")}</span>
    <span data-pagefind-meta="risk">{riskValues.join(",")}</span>
    <span data-pagefind-meta="flags">{String(skill.scan.flags.length)}</span>
    <span data-pagefind-meta="rank">{String(skill.editorial?.featuredRank ?? 9999)}</span>
    <span data-pagefind-meta="publicId">{skill.publicId}</span>
  </div>

  <div class="container-page py-10 md:py-14" data-pagefind-body>
    <nav class="flex items-center gap-2 font-mono text-[10px] text-faint" aria-label="面包屑">
      <a href="/explore" class="hover:text-accent">Explore</a>
      <span aria-hidden="true">/</span>
      <span data-pagefind-meta="repo">{skill.source.fullName}</span>
      <span aria-hidden="true">/</span>
      <span class="text-muted">{skill.name}</span>
    </nav>

    <div data-search-context data-pagefind-ignore="all" hidden class="mt-5 flex flex-wrap items-center gap-3 rounded-lg border border-line bg-surface px-4 py-3 text-[11px] text-muted">
      <span>搜索：<strong data-search-query class="font-medium text-ink"></strong></span>
      <a data-search-back href="/explore" class="text-accent hover:underline">返回搜索结果</a>
    </div>

    <div class="mt-7 flex flex-wrap items-center gap-2" data-pagefind-ignore>
      <span class="chip" data-pagefind-meta="status">{statusLabel(skill.status)}</span>
      <span class="chip" data-pagefind-meta="scan">{scanLabel(skill.scan.status)}</span>
      <span class="chip">{reviewLabel(skill.review.status)}</span>
      <span class="chip" data-pagefind-meta="license">{licenseText}</span>
      {isDraft && (
        <span class="chip chip-accent">
          {skill.review.status === "human-approved"
            ? "已人工复核 · 仍为草稿"
            : skill.review.status === "stale"
              ? "自动扫描 · 复核已失效"
              : "自动扫描 · 未人工复核"}
        </span>
      )}
    </div>

    <div class="mt-4 flex flex-col justify-between gap-5 md:flex-row md:items-start">
      <div class="max-w-3xl">
        <h1 class="text-[38px] font-semibold leading-[1.05] tracking-[-0.04em] md:text-[54px]" data-pagefind-meta="title">
          {skill.name}
        </h1>
        <p class="mt-4 text-[16px] leading-7 text-muted md:text-[17px]" data-pagefind-meta="description" data-search-highlight>
          {skill.descriptionZh ?? skill.description}
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-1.5">
          {skill.taxonomy.topics.map((topic) => (
            <span class="chip">{topicLabel(topic)}</span>
          ))}
          {skill.taxonomy.scenes.map((sceneId) => {
            const scene = getScene(sceneId);
            return (
              <a href={`/explore?scene=${sceneId}`} class="chip transition-colors hover:border-accent hover:text-accent">
                {scene?.title ?? sceneId}
              </a>
            );
          })}
        </div>
        <div class="mt-4 flex flex-wrap items-center gap-3" data-pagefind-ignore="all">
          <AgentBadges agents={skill.taxonomy.agents} portability={skill.taxonomy.portability} />
          <span class="text-[11px] text-faint">兼容性未逐一验证</span>
        </div>
      </div>
      <a
        href={sourceUrl}
        class="shrink-0 rounded-md border border-line-strong px-3 py-2 text-[12px] text-muted transition-colors hover:border-accent hover:text-accent"
        target="_blank"
        rel="noopener noreferrer"
        data-pagefind-ignore="all"
      >
        在 GitHub 查看 ↗
      </a>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
      <div class="min-w-0 space-y-10">
        <section>
          <h2 class="section-kicker">What it does</h2>
          <div class="mt-3 space-y-4 text-[14px] leading-7 text-muted">
            <p>{skill.descriptionZh ?? skill.description}</p>
            {skill.descriptionZh && skill.descriptionZh !== skill.description && (
              <details class="rounded-lg border border-line bg-surface px-4 py-3">
                <summary class="cursor-pointer text-[11px] text-faint">英文原文</summary>
                <p class="mt-3 text-[13px] leading-6" data-search-highlight>{skill.description}</p>
              </details>
            )}
          </div>
        </section>

        <section data-pagefind-ignore="all">
          <h2 class="section-kicker">When to use it</h2>
          {sceneItems.length > 0 ? (
            <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
              {sceneItems.map((scene) => (
                <div class="card p-4">
                  <h3 class="text-[14px] font-semibold">{scene.title}</h3>
                  <p class="mt-2 text-[12px] leading-5 text-muted">{scene.description}</p>
                  <p class="mt-3 font-mono text-[10px] leading-5 text-faint">不适合：{scene.notFor}</p>
                </div>
              ))}
            </div>
          ) : (
            <p class="mt-3 text-[13px] text-muted">这个条目暂未归入场景；请根据描述判断是否适合。</p>
          )}
        </section>

        <section>
          <div class="flex items-end justify-between gap-4 border-b border-line pb-3">
            <div>
              <h2 class="section-kicker">Ingredients</h2>
              <p class="mt-2 text-[16px] font-semibold">配料表</p>
            </div>
            <span class="chip">{scanLabel(skill.scan.status)} · 自动扫描</span>
          </div>

          <div class="mt-4 grid gap-3 md:grid-cols-3">
            <div class="card p-4">
              <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-faint">Files</p>
              <p class="mt-2 text-[22px] font-semibold">{skill.metrics.fileCount}</p>
              <p class="mt-1 text-[11px] text-muted">来自 tarball 的实际文件</p>
            </div>
            <div class="card p-4">
              <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-faint">Tokens</p>
              <p class="mt-2 text-[22px] font-semibold">{formatTokens(skill.metrics.bodyTokensEstimate)}</p>
              <p class="mt-1 text-[11px] text-muted">按文件字节粗略估算</p>
            </div>
            <div class="card p-4">
              <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-faint">Scripts</p>
              <p class="mt-2 text-[22px] font-semibold">{skill.metrics.scriptCount ?? "—"}</p>
              <p class="mt-1 text-[11px] text-muted">脚本已扫描，未执行</p>
            </div>
          </div>

          <div class="mt-4 overflow-x-auto rounded-lg border border-line">
            <table class="w-full text-left text-[12px]">
              <thead class="bg-surface-2 text-faint">
                <tr>
                  <th class="px-4 py-3 font-medium">文件</th>
                  <th class="px-4 py-3 font-medium">大小</th>
                  <th class="px-4 py-3 font-medium">类型</th>
                  <th class="px-4 py-3 font-medium">扫描</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line bg-surface">
                {skill.files.map((file) => (
                  <tr>
                    <td class="break-all px-4 py-3 font-mono text-[11px] text-ink">{file.path}</td>
                    <td class="px-4 py-3 text-muted">{formatBytes(file.size)}</td>
                    <td class="px-4 py-3 text-muted">{file.kind}</td>
                    <td class="px-4 py-3 text-muted">{file.scanned ? "已扫描" : "未扫描"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="mt-4 grid gap-3 md:grid-cols-2">
            <div class="card p-4">
              <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-faint">Scan</p>
              <p class="mt-2 text-[14px] font-semibold">{scanLabel(skill.scan.status)}</p>
              <p class="mt-2 text-[11px] leading-5 text-muted">
                扫描文件 {skill.scan.coverage.filesScanned} 个，跳过 {skill.scan.coverage.filesSkipped} 个。
              </p>
              {skill.scan.coverage.limitations.length > 0 && (
                <ul class="mt-3 space-y-1 text-[10px] leading-5 text-faint">
                  {skill.scan.coverage.limitations.map((item) => <li>· {item}</li>)}
                </ul>
              )}
            </div>
            <div class="card p-4">
              <div class="flex items-center justify-between gap-2">
                <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-faint">Review</p>
                <span
                  class={`chip ${
                    skill.review.status === "human-approved"
                      ? "border-accent/40 text-accent"
                      : skill.review.status === "stale"
                        ? "border-warn/40 text-warn"
                        : ""
                  }`}
                >
                  {reviewLabel(skill.review.status)}
                </span>
              </div>
              {skill.review.reviewed ? (
                <div class="mt-3 space-y-2 text-[11px] leading-5">
                  <div class="flex justify-between gap-3">
                    <span class="text-faint">复核人</span>
                    <span class="text-muted">{skill.review.reviewed.reviewer}</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span class="text-faint">复核时间</span>
                    <span class="text-muted">{formatDate(skill.review.reviewed.reviewedAt)}</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span class="text-faint">复核版本</span>
                    <span class="mono text-muted">@{shortCommit(skill.review.reviewed.commit)}</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span class="text-faint">复核 bundle</span>
                    <span class="mono text-muted">{skill.review.reviewed.bundleHash.slice(0, 10)}</span>
                  </div>
                  <div class="pt-2">
                    <p class="text-faint">看了什么</p>
                    <div class="mt-1.5 flex flex-wrap gap-1">
                      {skill.review.reviewed.scope.map((item) => (
                        <span class="chip">{scopeLabels[item] ?? item}</span>
                      ))}
                    </div>
                  </div>
                  {skill.review.reviewed.notes && (
                    <p class="pt-1 text-muted">{skill.review.reviewed.notes}</p>
                  )}
                </div>
              ) : (
                <p class="mt-3 text-[11px] leading-5 text-muted">{skill.review.notes}</p>
              )}
            </div>
          </div>

          <div class="mt-4">
            <div class="flex items-center justify-between gap-3">
              <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-faint">Risk flags</p>
              <span class="chip">{skill.scan.flags.length} 项命中</span>
            </div>
            {skill.scan.flags.length === 0 ? (
              <p class="mt-3 rounded-lg border border-line bg-surface px-4 py-3 text-[11px] leading-5 text-muted">
                在已扫描文件中未命中已知规则。这只表示没有发现模式，不代表安全。
              </p>
            ) : (
              <div class="mt-3 space-y-2">
                {skill.scan.flags.map((flag) => (
                  <details class="rounded-lg border border-line bg-surface px-4 py-3">
                    <summary class="flex cursor-pointer flex-wrap items-center gap-2 text-[12px]">
                      <span class={`chip ${severityClass[flag.severity] ?? ""}`}>{flag.severity}</span>
                      <span class="mono text-[11px] text-ink">{flag.code}</span>
                      <span class="text-[11px] text-muted">{flag.note}</span>
                    </summary>
                    <div class="mt-3 space-y-2 border-t border-line pt-3">
                      {flag.evidence.map((evidence) => (
                        <div class="text-[11px] leading-5">
                          <p class="font-mono text-[10px] text-faint">
                            {evidence.file}{evidence.line ? `:${evidence.line}` : ""}
                          </p>
                          <p class="mt-1 break-words text-muted">{evidence.excerpt}</p>
                        </div>
                      ))}
                    </div>
                  </details>
                ))}
              </div>
            )}
          </div>
        </section>

        <section data-pagefind-ignore="all">
          <div class="flex flex-wrap items-end justify-between gap-3 border-b border-line pb-3">
            <div>
              <h2 class="section-kicker">Version consistency</h2>
              <p class="mt-2 text-[16px] font-semibold">版本一致性</p>
            </div>
            <span class={`chip ${versionTone[versionState.tone]}`}>{versionState.label}</span>
          </div>

          <p
            class={`mt-4 rounded-lg border px-4 py-3 text-[11px] leading-5 text-muted ${
              versionState.tone === "warn" ? "border-warn/30 bg-warn/5" : "border-line bg-surface"
            }`}
          >
            {versionState.text}
          </p>

          <div class="mt-4 overflow-x-auto rounded-lg border border-line">
            <table class="w-full text-left text-[12px]">
              <thead class="bg-surface-2 text-faint">
                <tr>
                  <th class="px-4 py-2.5 font-medium">版本</th>
                  <th class="px-4 py-2.5 font-medium">commit / 指纹</th>
                  <th class="px-4 py-2.5 font-medium">状态</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line bg-surface">
                {versionRows.map((row) => (
                  <tr>
                    <th class="w-28 px-4 py-3 text-left font-medium text-faint">{row.label}</th>
                    <td class="break-all px-4 py-3 font-mono text-[11px] text-ink">{row.value}</td>
                    <td class="px-4 py-3">
                      <span class={`chip ${versionTone[row.tone]}`}>{row.state}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="mt-3 text-[10px] leading-5 text-faint">
            bundle 指纹是文件清单与内容的 SHA-256。上游继续更新时以 GitHub 为准；
            复核过期不会自动改写安装命令，默认安装仍指向已复核版本。
          </p>
        </section>

        {related.length > 0 && (
          <section data-pagefind-ignore="all">
            <h2 class="section-kicker">Related</h2>
            <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {related.map((item) => <SkillCard skill={item} compact />)}
            </div>
          </section>
        )}
      </div>

      <aside class="space-y-4 lg:sticky lg:top-20 lg:self-start" data-pagefind-ignore="all">
        <InstallCommand
          client:load
          latestCommand={skill.install.latestCommand}
          useCommand={skill.install.useCommand}
          reviewedCommand={skill.install.reviewedCommand}
          reviewedCommit={skill.review.reviewed?.commit}
        />

        <div class="card p-4">
          <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-faint">Source</p>
          <a
            href={skill.source.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 block text-[13px] font-medium text-ink hover:text-accent"
          >
            {skill.source.fullName} ↗
          </a>
          <p class="mt-1 font-mono text-[10px] text-faint">{skill.path}</p>
          <div class="mt-4 space-y-2 text-[11px]">
            <div class="flex justify-between gap-3">
              <span class="text-faint">Stars</span>
              <span class="text-muted">{skill.source.stars.toLocaleString("en-US")}</span>
            </div>
            <div class="flex justify-between gap-3">
              <span class="text-faint">License</span>
              <span class="text-muted">{licenseText}</span>
            </div>
            <div class="flex justify-between gap-3">
              <span class="text-faint">Updated</span>
              <span class="text-muted">{formatDate(skill.source.pushedAt)}</span>
            </div>
            <div class="flex justify-between gap-3">
              <span class="text-faint">Bundle</span>
              <span class="mono text-muted">{skill.snapshot.bundleHash.slice(0, 10)}</span>
            </div>
          </div>
        </div>

        <div class="rounded-lg border border-warn/30 bg-warn/5 p-4">
          <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-warn">Not a safety check</p>
          <p class="mt-2 text-[11px] leading-5 text-muted">
            {skill.review.reviewed
              ? "已有人工复核记录，但复核是“人看过”，不是安全认证。扫描只读取文本，未执行任何脚本。安装前请自行确认。"
              : "这是自动扫描数据：已读取 skill 目录文本并做静态规则分析，但未人工复核，也没有执行任何脚本。不要把这当作安全认证。"}
          </p>
        </div>
      </aside>
    </div>
  </div>

  <script is:inline>
    const params = new URLSearchParams(window.location.search);
    const query = (params.get("q") || "").trim();
    if (query) {
      const context = document.querySelector("[data-search-context]");
      const queryLabel = document.querySelector("[data-search-query]");
      const back = document.querySelector("[data-search-back]");
      if (context) context.hidden = false;
      if (queryLabel) queryLabel.textContent = query;
      if (back) back.href = "/explore?q=" + encodeURIComponent(query);

      const roots = document.querySelectorAll("[data-search-highlight]");
      const lower = query.toLowerCase();
      for (const root of roots) {
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
        const nodes = [];
        while (walker.nextNode()) nodes.push(walker.currentNode);
        for (const node of nodes) {
          const text = node.textContent || "";
          const index = text.toLowerCase().indexOf(lower);
          if (index < 0) continue;
          const range = document.createRange();
          range.setStart(node, index);
          range.setEnd(node, index + query.length);
          const mark = document.createElement("mark");
          range.surroundContents(mark);
          break;
        }
      }
    }
  </script>
</BaseLayout>
