---
import BaseLayout from "../layouts/BaseLayout.astro";
import SkillCard from "../components/SkillCard.astro";
import { getAllSkills } from "../lib/skills";
import { scenes, shelves } from "../lib/content";

const skills = getAllSkills();
const filterLabels = {
  scenes: Object.fromEntries(scenes.map((scene) => [scene.id, scene.title])),
  shelves: Object.fromEntries(shelves.map((shelf) => [shelf.id, shelf.title])),
};
---

<BaseLayout
  title="全部 Skills"
  description="浏览 Skill Shelf 的全部条目；当前为 Phase 2 客户端过滤，不是全文搜索。"
>
  <div class="container-page py-12 md:py-16">
    <div class="flex flex-wrap items-center gap-2">
      <span class="chip chip-accent">Phase 2 · {skills.length} 个真实条目</span>
      <span class="chip">客户端过滤 · 非 Pagefind</span>
    </div>

    <h1 class="mt-6 text-[34px] font-semibold tracking-[-0.03em] md:text-[44px]">全部 Skills</h1>
    <p class="mt-3 max-w-2xl text-[14px] leading-7 text-muted">
      当前用简单的字符串匹配演示浏览体验；Phase 3 会替换为 Pagefind 全文搜索与分面过滤。
    </p>

    <form action="/explore" method="get" data-explore-form class="mt-7 flex max-w-2xl flex-col gap-2 sm:flex-row">
      <div data-filter-hidden></div>
      <label class="sr-only" for="explore-search">搜索 Skills</label>
      <input
        id="explore-search"
        data-explore-search
        name="q"
        type="search"
        placeholder="搜 skill、场景或技术，例如“补测试”"
        class="h-11 min-w-0 flex-1 rounded-lg border border-line bg-surface px-4 text-[13px] text-ink placeholder:text-faint focus:border-accent focus:outline-none"
      />
      <button
        type="submit"
        class="h-11 rounded-lg bg-accent px-5 text-[13px] font-semibold text-accent-ink transition-opacity hover:opacity-90"
      >
        搜索
      </button>
    </form>

    <div data-filter-chips class="mt-4 flex flex-wrap items-center gap-2" hidden></div>

    <script type="application/json" data-filter-labels set:html={JSON.stringify(filterLabels)}></script>

    <div class="mt-10 flex items-center justify-between border-b border-line pb-3">
      <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-faint">
        <span data-explore-count>{skills.length}</span> results
      </p>
      <p class="text-[11px] text-faint">按编辑推荐排序</p>
    </div>

    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-explore-grid>
      {skills.map((skill) => <SkillCard skill={skill} />)}
    </div>

    <div data-explore-empty hidden class="card mt-4 p-10 text-center">
      <p class="text-[15px] font-medium">没找到。</p>
      <p class="mt-2 text-[13px] text-muted">试试“补测试”“设计稿”或清除筛选。</p>
      <a href="/explore" class="mt-5 inline-block text-[12px] text-accent link-underline">清除全部筛选</a>
    </div>

    <div class="mt-12 border-t border-line pt-6">
      <p class="max-w-3xl text-[11px] leading-6 text-faint">
        说明：条目已完成静态扫描，但未人工复核；“未发现模式”不代表安全。这里的搜索仅匹配名称、
        描述和标签，不读取 SKILL.md 正文，也不代表任何安全结论。
      </p>
    </div>
  </div>

  <script is:inline>
    const input = document.querySelector("[data-explore-search]");
    const cards = Array.from(document.querySelectorAll("[data-skill-card]"));
    const count = document.querySelector("[data-explore-count]");
    const empty = document.querySelector("[data-explore-empty]");
    const chips = document.querySelector("[data-filter-chips]");
    const hiddenFields = document.querySelector("[data-filter-hidden]");
    const labelsNode = document.querySelector("[data-filter-labels]");
    const labels = labelsNode?.textContent ? JSON.parse(labelsNode.textContent) : { scenes: {}, shelves: {} };
    const params = new URLSearchParams(window.location.search);
    const scene = params.get("scene") || "";
    const shelf = params.get("shelf") || "";

    if (input instanceof HTMLInputElement) {
      input.value = params.get("q") || "";
    }

    function addChip(label, href) {
      if (!chips) return;
      const chip = document.createElement("span");
      chip.className = "chip chip-accent";
      chip.append(document.createTextNode(label));
      const clear = document.createElement("a");
      clear.href = href;
      clear.textContent = "×";
      clear.className = "ml-1 text-ink/70 hover:text-ink";
      clear.setAttribute("aria-label", `清除${label}`);
      chip.append(clear);
      chips.append(chip);
    }

    if (scene) {
      addChip(`场景：${labels.scenes[scene] || scene}`, "/explore");
      const field = document.createElement("input");
      field.type = "hidden";
      field.name = "scene";
      field.value = scene;
      hiddenFields?.append(field);
    }
    if (shelf) {
      addChip(`专题：${labels.shelves[shelf] || shelf}`, "/explore");
      const field = document.createElement("input");
      field.type = "hidden";
      field.name = "shelf";
      field.value = shelf;
      hiddenFields?.append(field);
    }
    if ((scene || shelf) && chips) chips.hidden = false;

    function applyFilter() {
      const query = (input instanceof HTMLInputElement ? input.value : "").trim().toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const text = (card.getAttribute("data-search") || "").toLowerCase();
        const cardScenes = (card.getAttribute("data-scenes") || "").split(/\s+/).filter(Boolean);
        const cardShelves = (card.getAttribute("data-shelves") || "").split(/\s+/).filter(Boolean);
        const matchesQuery = !query || text.includes(query);
        const matchesScene = !scene || cardScenes.includes(scene);
        const matchesShelf = !shelf || cardShelves.includes(shelf);
        const show = matchesQuery && matchesScene && matchesShelf;
        card.hidden = !show;
        if (show) visible += 1;
      }
      if (count) count.textContent = String(visible);
      if (empty) empty.hidden = visible !== 0;

      const url = new URL(window.location.href);
      if (query) url.searchParams.set("q", input.value.trim());
      else url.searchParams.delete("q");
      window.history.replaceState(null, "", url);
    }

    input?.addEventListener("input", applyFilter);
    applyFilter();
  </script>
</BaseLayout>
