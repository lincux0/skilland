---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchExplorer, { type SearchItem } from "../components/SearchExplorer";
import { getAllSkills } from "../lib/skills";
import { licenseLabel } from "../lib/format";

const items: SearchItem[] = getAllSkills().map((skill) => ({
  url: `/skill/${skill.publicId}/`,
  title: skill.name,
  repo: skill.source.fullName,
  description: skill.descriptionZh ?? skill.description,
  license: licenseLabel(skill.source.licenseSpdx, skill.source.licenseStatus),
  scan: skill.scan.status,
  status: skill.status,
  agents: skill.taxonomy.agents,
  risks: skill.scan.flags.length
    ? [...new Set(skill.scan.flags.map((flag) => flag.severity))]
    : ["none"],
  scenes: skill.taxonomy.scenes,
  shelves: skill.editorial?.shelfIds ?? [],
  flags: skill.scan.flags.length,
  rank: skill.editorial?.featuredRank ?? 9999,
}));
---

<BaseLayout
  title="全部 Skills"
  description="用 Pagefind 中文全文搜索、客户端/扫描/风险/许可证/场景/专题分面筛选 112 个 Agent Skills。"
>
  <SearchExplorer client:load initialItems={items} />
</BaseLayout>
