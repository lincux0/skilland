---
import AgentBadges from "./AgentBadges.astro";
import type { SkillRecord } from "../lib/schema";
import { licenseLabel, scanLabel, statusLabel } from "../lib/format";

interface Props {
  skill: SkillRecord;
  compact?: boolean;
}

const { skill, compact = false } = Astro.props;
const description = skill.descriptionZh ?? skill.description;
const notableFlags = skill.scan.flags.filter((flag) =>
  ["critical", "high"].includes(flag.severity),
).length;
const searchText = [
  skill.name,
  skill.description,
  skill.descriptionZh ?? "",
  ...skill.taxonomy.topics,
  ...skill.taxonomy.scenes,
].join(" ");
---

<a
  href={`/skill/${skill.publicId}/`}
  class="group card flex min-w-0 flex-col p-4 transition-colors hover:border-accent/50 hover:bg-surface-2/60"
  data-skill-card
  data-skill-url
  data-search={searchText}
  data-scenes={skill.taxonomy.scenes.join(" ")}
  data-shelves={(skill.editorial?.shelfIds ?? []).join(" ")}
  aria-label={`${skill.name}：${description}`}
>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h3 class="truncate text-[15px] font-semibold tracking-tight text-ink group-hover:text-accent">
        {skill.name}
      </h3>
      <p class="mt-1 font-mono text-[10px] text-faint">
        {skill.source.owner}/{skill.source.repo}
      </p>
    </div>
    <AgentBadges agents={skill.taxonomy.agents} />
  </div>

  <p class:list={["mt-3 text-[13px] leading-6 text-muted", compact ? "line-clamp-2" : "line-clamp-3"]}>
    {description}
  </p>

  <div class="mt-auto flex flex-nowrap items-center gap-1.5 overflow-hidden pt-4">
    <span class="chip">{licenseLabel(skill.source.licenseSpdx, skill.source.licenseStatus)}</span>
    <span class="chip">{scanLabel(skill.scan.status)}</span>
    {notableFlags > 0 && <span class="chip">{notableFlags} 项高风险</span>}
    {skill.status === "draft" && <span class="chip chip-accent">{statusLabel(skill.status)}</span>}
  </div>
</a>
