---
import CommandPalette from "./CommandPalette";

const links = [
  { href: "/explore", label: "全部 Skills" },
  { href: "/#scenes", label: "按场景" },
  { href: "/#collections", label: "专题" },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-canvas/85 backdrop-blur-xl">
  <div class="container-page flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3">
      <span class="grid h-8 w-8 place-items-center rounded-[9px] border border-line-strong bg-surface-2">
        <span class="grid grid-cols-2 gap-[3px]" aria-hidden="true">
          <span class="h-[5px] w-[5px] rounded-[1px] bg-accent"></span>
          <span class="h-[5px] w-[5px] rounded-[1px] bg-muted"></span>
          <span class="h-[5px] w-[5px] rounded-[1px] bg-muted"></span>
          <span class="h-[5px] w-[5px] rounded-[1px] bg-accent"></span>
        </span>
      </span>
      <span class="flex flex-col leading-none">
        <span class="text-[15px] font-semibold tracking-tight">Skill Shelf</span>
        <span class="mt-1 font-mono text-[9px] uppercase tracking-[0.18em] text-faint">
          agent skills, curated
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
      {links.map((link) => (
        <a
          href={link.href}
          class="rounded-md px-3 py-2 text-[13px] text-muted transition-colors hover:bg-surface-2 hover:text-ink"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <span class="chip chip-accent hidden sm:inline-flex">Phase 3</span>
      <CommandPalette client:load />
      <a
        href="/explore"
        class="hidden shrink-0 whitespace-nowrap rounded-md border border-line-strong px-3 py-2 text-[12px] text-ink transition-colors hover:border-accent hover:text-accent sm:inline-flex"
      >
        浏览全部
      </a>
    </div>
  </div>
</header>
