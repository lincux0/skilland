---
import { AGENT_ICONS, AGENT_LABELS } from "../lib/agent-icons";

interface Props {
  agents: string[];
}

const { agents } = Astro.props;
---

<span class="inline-flex items-center gap-1">
  {agents.map((agent) => {
    const icon = AGENT_ICONS[agent];
    const label = AGENT_LABELS[agent] ?? agent;
    return (
      <span
        class="grid h-5 w-5 place-items-center rounded-[5px] border border-line bg-surface-2 text-muted"
        title={label}
        role="img"
        aria-label={label}
      >
        {icon ? (
          <svg viewBox={icon.viewBox} class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true">
            {icon.paths.map((path) => (
              <path d={path.d} opacity={path.opacity} fill-rule={path.fillRule} />
            ))}
          </svg>
        ) : (
          <span class="font-mono text-[9px]">{agent.slice(0, 2).toUpperCase()}</span>
        )}
      </span>
    );
  })}
</span>
