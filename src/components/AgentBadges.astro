---
interface Props {
  agents: string[];
  portability?: "portable" | "client-specific" | "unknown";
}

const { agents, portability = "unknown" } = Astro.props;
const labels: Record<string, { short: string; label: string }> = {
  opencode: { short: "OC", label: "OpenCode" },
  "claude-code": { short: "CC", label: "Claude Code" },
  codex: { short: "CX", label: "Codex" },
  cursor: { short: "CU", label: "Cursor" },
};
const unverified = portability === "unknown";
---

<span class="inline-flex items-center gap-1" title={unverified ? "兼容性未逐一验证" : undefined}>
  {agents.map((agent) => {
    const item = labels[agent] ?? { short: agent.slice(0, 2).toUpperCase(), label: agent };
    return (
      <span
        class="grid h-5 min-w-5 place-items-center rounded-[5px] border border-line bg-surface-2 px-1 font-mono text-[9px] text-muted"
        title={item.label}
      >
        {item.short}
      </span>
    );
  })}
  {unverified && <span class="font-mono text-[9px] text-faint" title="兼容性未逐一验证">?</span>}
</span>
